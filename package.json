{
  "name": "dsh-plugin-closure-board",
  "version": "0.2.9",
  "description": "Closure workflow board for DSH: stage progress and tasks.md checklist in the right sidebar",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "DESIGN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigdiliu777/dsh-plugin-closure-board.git"
  },
  "homepage": "https://github.com/bigdiliu777/dsh-plugin-closure-board#readme",
  "bugs": {
    "url": "https://github.com/bigdiliu777/dsh-plugin-closure-board/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "openspec",
    "closure"
  ]
}
